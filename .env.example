# Backend only: copy to .env.web, never commit real credentials.
NODE_ENV=development
APP_BASE_URL=http://127.0.0.1:3100
WEB_HOST=127.0.0.1
WEB_PORT=3100
WEB_DATABASE_PATH=./data/web.sqlite
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
# Register APP_BASE_URL/auth/discord/callback in Discord Developer Portal.
SESSION_SECRET=
WEB_ORIGIN_SECRET=
# Vercel only: HTTPS origin of the independently deployed backend.
WEB_BACKEND_ORIGIN=
# Production must set WEB_REQUIRE_HTTPS_PROXY=true behind a local TLS proxy.
WEB_REQUIRE_HTTPS_PROXY=false
