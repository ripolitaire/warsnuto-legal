{
  "name": "warsnuto-web",
  "version": "1.0.0",
  "private": true,
  "description": "Site public et plateforme privee WarsNuto",
  "engines": {
    "node": ">=24.12 <25"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "node --env-file-if-exists=.env.web server/start.cjs",
    "dev": "node --env-file-if-exists=.env.web server/start.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:public": "node --test tests/public-*.test.cjs",
    "test:browser": "playwright test",
    "check": "node scripts/check.cjs",
    "owner": "node --env-file-if-exists=.env.web server/owner.cjs",
    "backup:web": "node --env-file-if-exists=.env.web server/backup.cjs"
  },
  "dependencies": {
    "express": "5.3.0",
    "lucide": "1.67.0",
    "oauth4webapi": "3.8.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "esbuild": "0.28.2"
  }
}
