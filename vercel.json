{
  "buildCommand": "npm run build",
  "installCommand": "npm ci --include=dev",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/game.html",
      "destination": "/game",
      "permanent": true
    },
    {
      "source": "/protect",
      "has": [
        {
          "type": "host",
          "value": "warsnuto-bots.vercel.app"
        }
      ],
      "destination": "https://warsnuto.com/protect",
      "permanent": true
    },
    {
      "source": "/support",
      "has": [
        {
          "type": "host",
          "value": "warsnuto-bots.vercel.app"
        }
      ],
      "destination": "https://warsnuto.com/support",
      "permanent": true
    },
    {
      "source": "/protect",
      "has": [
        {
          "type": "host",
          "value": "warsnuto-bots-.*\\.vercel\\.app"
        }
      ],
      "destination": "https://warsnuto.com/protect",
      "permanent": true
    },
    {
      "source": "/support",
      "has": [
        {
          "type": "host",
          "value": "warsnuto-bots-.*\\.vercel\\.app"
        }
      ],
      "destination": "https://warsnuto.com/support",
      "permanent": true
    },
    {
      "source": "/protect.html",
      "destination": "/protect",
      "permanent": true
    },
    {
      "source": "/support.html",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "warsnuto-bots.vercel.app"
        }
      ],
      "destination": "https://warsnuto.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "warsnuto-bots-.*\\.vercel\\.app"
        }
      ],
      "destination": "https://warsnuto.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "warsnuto-legal.vercel.app"
        }
      ],
      "destination": "https://warsnuto.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/auth/discord/start", "destination": "/api/platform?route=auth/discord/start" },
    { "source": "/auth/discord/callback", "destination": "/api/platform?route=auth/discord/callback" },
    { "source": "/api/platform/:rest*", "destination": "/api/platform?route=api/platform/:rest*" },
    { "source": "/profile", "destination": "/api/platform?route=profile" },
    { "source": "/servers", "destination": "/api/platform?route=servers" },
    { "source": "/profile/settings", "destination": "/api/platform?route=profile/settings" },
    { "source": "/profile/game", "destination": "/api/platform?route=profile/game" },
    { "source": "/profile/protect", "destination": "/api/platform?route=profile/protect" },
    { "source": "/admin", "destination": "/api/platform?route=admin" },
    { "source": "/admin/bots", "destination": "/api/platform?route=admin/bots" },
    { "source": "/admin/configuration", "destination": "/api/platform?route=admin/configuration" },
    { "source": "/admin/users", "destination": "/api/platform?route=admin/users" },
    { "source": "/admin/staff", "destination": "/api/platform?route=admin/staff" },
    { "source": "/admin/logs", "destination": "/api/platform?route=admin/logs" },
    { "source": "/admin/settings", "destination": "/api/platform?route=admin/settings" },
    { "source": "/admin/moderation", "destination": "/api/platform?route=admin/moderation" },
    { "source": "/admin/prisons", "destination": "/api/platform?route=admin/prisons" },
    {
      "source": "/game",
      "destination": "/game.html"
    },
    {
      "source": "/discord",
      "destination": "/discord.html"
    },
    {
      "source": "/youtube",
      "destination": "/youtube.html"
    },
    {
      "source": "/bots",
      "destination": "/bots.html"
    },
    {
      "source": "/protect",
      "destination": "/protect.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/docs",
      "destination": "/docs.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://va.vercel-scripts.com; style-src 'self'; img-src 'self' data: https://*.ytimg.com https://yt3.googleusercontent.com https://cdn.discordapp.com https://media.discordapp.net; connect-src 'self' https://discord.com https://discordapp.com https://vitals.vercel-insights.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/api/visits",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/platform.js": { "maxDuration": 60 },
    "api/bots.js": {
      "maxDuration": 60
    }
  }
}
